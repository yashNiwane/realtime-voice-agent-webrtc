# Server Configuration
HOST=0.0.0.0
PORT=7860
DEVICE=cuda            # 'cuda' on Kaggle GPU, 'cpu' on local machine
TORCH_DTYPE=float16    # 'float16' on GPU, 'int8' dynamic on CPU

# ASR (Speech-to-Text)
ASR_MODEL=Qwen/Qwen3-ASR-0.6B
ASR_LANGUAGE=Hindi
ASR_CHUNK_SIZE_MS=50
ASR_QUANTIZE=true

# VAD (Voice Activity Detection)
VAD_CONFIDENCE=0.70
VAD_START_SECS=0.20
VAD_STOP_SECS=0.45

# LLM (Language Model)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_THINKING=false

# TTS (Text-to-Speech)
TTS_ENGINE=vits        # 'vits' (Local Offline Neural), 'edge' (Free Cloud), 'cartesia' (Cloud API)
VITS_MODEL_ID=facebook/mms-tts-hin
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=95d51f79-c397-46f9-b49a-23763d3eaa2d
